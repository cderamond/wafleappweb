# ==============================================================================
# WAFFLE APP WEB — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Routing Provider: 'openrouteservice' | 'graphhopper' | 'mapbox' | 'offline_procedural'
NEXT_PUBLIC_ROUTING_PROVIDER=openrouteservice

# Optional Routing API Key (e.g. OpenRouteService token, Mapbox access token, or GraphHopper key)
# If empty or not set, the app defaults smoothly to the procedural curvy engine.
NEXT_PUBLIC_ROUTING_API_KEY=

# Custom Map Tile Layer (defaults to OpenStreetMap Carto if not specified)
# Example Stadia Maps or Maptiler: https://tiles.stadiamaps.com/tiles/alidade_smooth_dark/{z}/{x}/{y}{r}.png?api_key=YOUR_KEY
NEXT_PUBLIC_MAP_TILE_URL=
